[Unit]
Description=Jarvis client service
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/client >> /var/log/jarvis/client.log 2>&1
# Optionally set working directory, environment variables, etc.
# WorkingDirectory=/var/jarvis
# Environment=MY_ENV_VAR=some_value
LimitCORE=infinity
KillSignal=SIGABRT
Restart=on-failure

[Install]
WantedBy=multi-user.target
